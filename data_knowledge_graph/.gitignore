# ============================================================
# 成员 A 模块（Data & Knowledge Graph）的忽略规则
#
# 原则：原始数据、大体积派生件不入库（可用 scripts/ 一键重建）；
#       只保留体积很小的“元数据产物”（qa/gold 的 jsonl.gz），
#       这样队友 clone 后无需重跑流水线就能直接开始 B/C/D/E 的工作。
# ============================================================

# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/

# 原始数据（约 760 MB：官方 QA JSON + Freebase 子图 TSV）
data/raw/

# 中间件（mid2name，由 scripts/prepare_dataset.py 重建）
data/interim/

# 大体积派生件：KG 索引（256 MB）与逐题子图（约 215 MB）
data/processed/kg/
data/processed/*/subgraphs/

# 日志与临时文件
reports/logs/
*.log
*.part
.venv/
.DS_Store

# ------------------------------------------------------------------
# 重要：仓库根目录的 .gitignore 里有一行 `FoG/`（本意是忽略上游草稿目录），
# Windows 下路径匹配不区分大小写，会连带把本模块的 fog/ 目录也忽略掉。
# 这里显式反忽略，保证 fog/ 下的代码能被正常提交。
# ------------------------------------------------------------------
!fog/
!fog/**

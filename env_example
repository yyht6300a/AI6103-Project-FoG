# Copy to .env at the repository root. Never commit real credentials.
# Values here are literal; shell expansion and variable interpolation are unsupported.
# Blank non-secret values inherit config/config-dev.yml defaults.
# YAML defaults use OpenAI at https://api.openai.com/v1 with gpt-4o-mini.
# Supported inference models: deepseek-flash, gpt-4o-mini, gpt-4, gpt-4o.
# For local development only, set LLM_MODEL_NAME=deepseek-flash and
# LLM_BASE_URL=https://api.deepseek.com with a DeepSeek LLM_API_KEY in .env.
# Before module delivery, restore gpt-4o-mini and the OpenAI URL (or leave both
# blank to inherit YAML defaults), and use an OpenAI key. No automatic fallback.
# Set timeout and max_retries only in the YAML llm section.
LLM_MODEL_NAME=
LLM_API_KEY=
LLM_BASE_URL=
